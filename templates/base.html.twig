
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}Sterenfix{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --primary: #2563eb;
            --background: #f4f7fb;
            --text: #1e293b;
            --muted: #64748b;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 28px 16px 20px;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .brand {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary);
            padding: 0 16px 32px;
            white-space: nowrap;
        }

        .sidebar nav {
            flex: 1;
        }

        .sidebar nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 16px;
            margin-bottom: 7px;
            border-radius: 10px;
            text-decoration: none;
            color: #475569;
            font-weight: 500;
            transition: background 0.2s, color 0.2s;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #eff6ff;
            color: var(--primary);
        }

        .sidebar nav a i {
            width: 20px;
            text-align: center;
        }

        .user-panel {
            border-top: 1px solid #e2e8f0;
            padding-top: 18px;
            margin-top: 20px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .user-avatar {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            border-radius: 11px;
            background: #eff6ff;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .user-details {
            min-width: 0;
        }

        .user-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .user-email {
            font-size: 11px;
            color: var(--muted);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 155px;
        }

        .logout-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            width: 100%;
            padding: 11px;
            border-radius: 9px;
            border: 1px solid #fecaca;
            background: #fff5f5;
            color: #dc2626;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }

        .logout-button:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

        .main-content {
            margin-left: 250px;
            padding: 36px;
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
        }

        .subtitle {
            color: var(--muted);
        }

        .stat-card,
        .section-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.03);
        }

        .stat-card {
            height: 100%;
        }

        .stat-label {
            color: var(--muted);
            font-size: 14px;
        }

        .stat-number {
            font-size: 30px;
            font-weight: 750;
            margin-top: 14px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: #eff6ff;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
        }

        @media (max-width: 768px) {
            .sidebar {
                position: static;
                width: 100%;
                height: auto;
                min-height: auto;
                overflow-y: visible;
            }

            .sidebar nav {
                flex: none;
            }

            .user-panel {
                margin-top: 12px;
            }

            .main-content {
                margin-left: 0;
                padding: 20px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

    <aside class="sidebar">

        <div class="brand">
            <i class="bi bi-grid-1x2-fill"></i>
            STERENFIX
        </div>

        {% set currentRoute = app.request.attributes.get('_route') %}

        <nav>
            <a href="{{ path('app_dashboard') }}"
               class="{{ currentRoute == 'app_dashboard' ? 'active' : '' }}">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a href="{{ path('app_empleados') }}"
               class="{{ currentRoute == 'app_empleados' ? 'active' : '' }}">
                <i class="bi bi-people"></i>
                Empleados
            </a>

            <a href="{{ path('app_tiendas') }}"
               class="{{ currentRoute == 'app_tiendas' ? 'active' : '' }}">
                <i class="bi bi-shop"></i>
                Tiendas
            </a>

            <a href="{{ path('app_puestos') }}"
               class="{{ currentRoute == 'app_puestos' ? 'active' : '' }}">
                <i class="bi bi-briefcase"></i>
                Puestos
            </a>

            <a href="{{ path('app_registros') }}"
               class="{{ currentRoute == 'app_registros' ? 'active' : '' }}">
                <i class="bi bi-journal-text"></i>
                Registros
            </a>

            
                <a href="{{ path('app_reportes') }}"
                class="nav-link {{ app.request.attributes.get('_route') == 'app_reportes' ? 'active' : '' }}">
                    <i class="bi bi-bar-chart-line"></i>
                    <span>Reportes</span>
                </a>


            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_usuarios') }}"
                class="{{ currentRoute == 'app_usuarios' ? 'active' : '' }}">
                    <i class="bi bi-person-gear"></i>
                    Usuarios
                </a>
            {% endif %}

        </nav>

        {% if app.user %}
            <div class="user-panel">

                <div class="user-info">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="user-details">
                        <div class="user-name">
                            {{ is_granted('ROLE_ADMIN') ? 'Administrador' : 'Usuario' }}
                        </div>

                        <div class="user-email"
                             title="{{ app.user.userIdentifier }}">
                            {{ app.user.userIdentifier }}
                        </div>
                    </div>
                </div>

                <a href="{{ path('app_logout') }}" class="logout-button">
                    <i class="bi bi-box-arrow-right"></i>
                    Cerrar sesión
                </a>

            </div>
        {% endif %}

    </aside>

    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}

</body>
</html>
