
{% extends 'base.html.twig' %}

{% block title %}Usuarios | Sterenfix{% endblock %}

{% block body %}


        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="fw-bold mb-1">Usuarios registrados</h5>
                <p class="text-secondary small mb-0">
                    Total de usuarios: {{ usuarios|length }}
                </p>
            </div>

            <a href="{{ path('app_usuarios_nuevo') }}"
            class="btn btn-primary">
                <i class="bi bi-person-plus me-2"></i>
                Nuevo usuario
            </a>
        </div>

        {% for mensaje in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                {{ mensaje }}
            </div>
        {% endfor %}


    <span class="badge bg-primary-subtle text-primary px-3 py-2">
        <i class="bi bi-shield-lock me-1"></i>
        Solo administradores
    </span>
</div>

<div class="section-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1">Usuarios registrados</h5>
            <p class="text-secondary small mb-0">
                Total de usuarios: {{ usuarios|length }}
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td>{{ usuario.id }}</td>

                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div
                                    class="d-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary"
                                    style="width: 40px; height: 40px;"
                                >
                                    <i class="bi bi-person-fill"></i>
                                </div>

                                <div>
                                    <div class="fw-semibold">
                                        {{ usuario.email }}
                                    </div>

                                    {% if app.user.id == usuario.id %}
                                        <small class="text-primary">
                                            Tu cuenta
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        <td>
                            {% if 'ROLE_ADMIN' in usuario.roles %}
                                <span class="badge bg-primary">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Administrador
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">
                                    <i class="bi bi-person me-1"></i>
                                    Usuario
                                </span>
                            {% endif %}
                        </td>

                        <td>
                            <span class="badge bg-success-subtle text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Registrado
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-4 text-secondary">
                            No hay usuarios registrados.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>

{% endblock %}
